data/
.venv/
__pycache__/
*.pyc
.env
.pytest_cache/

# Secrets. A live credential in a git history outlives every attempt to
# delete it, so these never get committed -- the key travels by direct
# message instead.
local_api_key.txt
*.key
# TikTok login cookies (AUDITOR_COOKIES_FILE) -- a logged-in session.
cookies.txt
*cookies*.txt

# Runtime noise: server and tunnel logs, one-off job dumps. None of it
# describes the code, and the logs echo the effective settings.
server.log
server.err
server*.log
tunnel*.log
ngrok*.log
docker_build.log
job_id.txt
run2.json
run_result_*.json
