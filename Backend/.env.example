# Copy to .env and fill in. NEVER commit the filled-in file.
#
# There are no real secrets in this file and there never must be. The notebook
# learned this the hard way: a key pasted "just for testing" was copied into
# every build, every .bak, and every file that left the machine.

# ---------------------------------------------------------------------------
# SECRETS
# ---------------------------------------------------------------------------
# Gemini is MANDATORY. Phase 3 sends frames to it, and Phases 4 and 6 use it
# for brief compilation and L3 adjudication. There is no local fallback in
# this deployment -- the API refuses a request rather than quietly using a
# different model.  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI is the PAID fallback, used only after Gemini has exhausted its model
# ladder, and bounded by P4.brief.paid_call_budget. Leave empty to stay free.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# HUGGING FACE  --  OPTIONAL. Everything works without it.
# ---------------------------------------------------------------------------
# Three models are pulled from the Hub on first use:
#
#   faster-whisper   large-v3-turbo (CTranslate2)   ~1.6 GB   Phase 2 ASR
#   transformers     whisper-large-v3-turbo         ~1.6 GB   ASR fallback
#   sentence-transf. BAAI/bge-small-en-v1.5         ~130 MB   Phase 6 L2 rung
#
# All three are PUBLIC, so no token is required. What a token buys is a much
# higher download rate limit. Anonymous pulls are throttled per IP, and a
# datacentre IP is throttled far harder than a home connection -- on a cold
# container fetching ~1.8 GB, that is the difference between a slow first
# request and a 429 that fails the job.
#
# Set it if: you deploy to a cloud host, you see rate-limit errors during model
# download, or you later swap in a gated/private model.
#
# Get one: https://huggingface.co/settings/tokens  ("Read" scope is enough --
# do not use a Write token here, this process never uploads anything.)
#
# Either variable name works; HF_TOKEN is the current one.
HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
# Where model weights are cached. Default is ~/.cache/huggingface.
# Point this at a PERSISTENT volume in production -- otherwise every cold boot
# re-downloads ~1.8 GB before the first frame is read, which will dominate
# your runtime. Better still, bake the weights into the image.
HF_HOME=

# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------
# artifacts/ and briefs/ are SHARED across jobs and content-addressed: the same
# video under the same config yields the same stage key, so sharing them is
# what makes a repeat request nearly free. jobs/<id>/ is per-request.
# Put this on a persistent volume -- losing it means re-paying every vision
# pass you have ever run.
AUDITOR_DATA_ROOT=./data

# ---------------------------------------------------------------------------
# PIPELINE  (defaults match the notebook exactly -- change deliberately)
# ---------------------------------------------------------------------------
# §90: "a ceiling, so a mis-clicked 50-video zip cannot spend the afternoon"
AUDITOR_MAX_VIDEOS=25

# §48: the compiler is the one non-deterministic stage. The same brief has
# compiled to 6, 9, 16, 21, 22 and 24 requirements across runs at temperature
# 0. Consensus keeps what a majority of runs agreed on and reports the rest as
# COMPILE_UNSTABLE. 1 = single-shot, faster, less stable.
AUDITOR_BRIEF_COMPILE_RUNS=3
AUDITOR_BRIEF_KEEP_THRESHOLD=0.5

# 'gemini' (hosted, no GPU, the supported path) or 'local' (needs a GPU and
# the Qwen weights; extracted but unwired in this deployment).
AUDITOR_VISION_PROVIDER=gemini

# ---------------------------------------------------------------------------
# EXECUTION
# ---------------------------------------------------------------------------
# ONE by default, and think before raising it. Phase 2 loads Whisper once,
# frees it, then loads OCR once; Phase 3 loads the vision backend once.
# Concurrent jobs multiply those loads and, on a GPU box, race for VRAM.
AUDITOR_MAX_CONCURRENT_JOBS=1

# Checked at PHASE BOUNDARIES, not mid-stage. Killing a worker mid-ffmpeg
# leaves half-written artifacts that a content-addressed cache cannot tell
# from good ones -- worse than a job that overran. Videos not reached are
# returned as SKIPPED_DEADLINE, and a re-run resumes from there for free.
AUDITOR_JOB_TIMEOUT_S=10800

# Deletes jobs/<id>/inbox and /reports after this many hours. The job RECORD
# is kept, and artifacts/ + briefs/ are NEVER swept -- they are shared and
# content-addressed, and deleting them re-pays every vision pass.
AUDITOR_KEEP_JOB_FILES_HOURS=72

# ---------------------------------------------------------------------------
# PARALLELISM  --  per stage, because the stages fail differently
# ---------------------------------------------------------------------------
# Pure network wait, independent per URL. Parallel is free and obviously right.
AUDITOR_DOWNLOAD_WORKERS=4

# Phase 1 ffmpeg/PyAV decode -- the CPU hot spot. Independent per video and
# content-addressed, so this is the one stage where parallelism is both safe
# and worth it (measured 1.83x on 4 clips / 8 cores, with byte-identical
# manifests). Each worker holds decoded frames, so it is capped: 8 workers on
# 1080p is gigabytes. Set 1 to run the notebook's own code path exactly.
AUDITOR_DECODE_WORKERS=4

# Phase 3 vision and Phase 6 audit. These LOOK like the biggest win -- 72-240s
# per video, nearly all of it waiting on Gemini -- and are deliberately 1.
# Those calls are rate-limited per model per minute; a live free-tier run
# returned 503 on seven of eight models and 429 on the eighth. Issuing them
# N-at-once turns a slow job into a failed one and makes the retry ladder
# spend its budget on self-inflicted congestion. Raise only on a paid tier,
# and raise slowly.
AUDITOR_VISION_WORKERS=1
AUDITOR_AUDIT_WORKERS=1

# ---------------------------------------------------------------------------
# INGESTION
# ---------------------------------------------------------------------------
# TikTok increasingly refuses anonymous downloads, and refuses a datacentre IP
# harder than a residential one. Export cookies from a logged-in browser
# ("Get cookies.txt LOCALLY") and point at the file. Empty = try without,
# which often still works from a residential IP.
#
# IN DOCKER this must be a path INSIDE the container -- /data is a named
# volume, not ./data on the host:
#     docker compose cp cookies.txt api:/data/cookies.txt
#     AUDITOR_COOKIES_FILE=/data/cookies.txt
AUDITOR_COOKIES_FILE=
AUDITOR_DOWNLOAD_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# SERVING  --  set AUDITOR_API_KEYS before this has a public address
# ---------------------------------------------------------------------------
# Comma-separated. EMPTY = THE API IS OPEN: anyone who can reach the port can
# submit jobs and spend your model quota. /ready reports `auth: OPEN` and
# startup logs a warning, so an unprotected deployment is visible rather than
# assumed -- but it is still open.
#
# Generate one:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUDITOR_API_KEYS=

# Empty = no CORS headers at all, which is correct for a server-to-server API.
# A browser front end should call your OWN backend, which then calls this one
# -- that keeps the key server-side and avoids CORS entirely.
AUDITOR_CORS_ORIGINS=

# Backpressure. Each job takes minutes, so an unbounded queue turns "too much
# work" into "nothing finishes and memory grows". 429 beyond this.
AUDITOR_MAX_QUEUED_JOBS=20

# Every endpoint takes a small JSON document. Without a ceiling an
# unauthenticated caller can make the process buffer arbitrary bytes.
AUDITOR_MAX_BODY_BYTES=2097152

# How long SIGTERM waits for a running job. Cloud platforms typically allow
# 10-30 s before SIGKILL; a longer grace here is a promise they will not keep.
AUDITOR_SHUTDOWN_GRACE_S=20

# Artifacts are the CACHE and are shared, so retention is a separate, longer
# decision than job workspaces. Whole per-video directories, by last touch.
# 0 = never sweep.
AUDITOR_KEEP_ARTIFACTS_DAYS=30

# Logged as an error below this. A short write becomes a corrupt artifact
# rather than a clean "disk full", so it is worth hearing about early.
AUDITOR_MIN_FREE_DISK_MB=2048

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
AUDITOR_LOG_LEVEL=INFO
AUDITOR_LOG_JSON=false

# The vision and text model probes send live requests to find a model that
# actually works. They run ONCE at startup, never per request. Set false in
# tests, or to pin whatever is configured.
AUDITOR_PROBE_ON_STARTUP=true

# ---------------------------------------------------------------------------
# PIN THE VISION MODEL  --  strongly recommended in production
# ---------------------------------------------------------------------------
# gemini_models[0] IS the visual cache key, and the startup probe ranks
# candidates by MEASURED SPEED, which moves between runs. Two runs minutes
# apart ranked 'gemini-3.1-flash-lite-preview' and 'gemini-3.1-flash-lite'
# first -- a different leader is a different key, so every run re-pays a
# 72-240s vision pass AND falls back to an artifact that no longer matches
# its config, which downgrades modality health and turns decided verdicts
# into UNCERTAIN.
#
# Pinning makes the key stable. The other probed models remain as fallbacks,
# so one 503 still does not kill a video.
#
# Prefer a CONCRETE version over a '-latest' alias: an alias keeps the cache
# key stable while the model behind it changes, which is the worse failure.
# Run `python tools/check_key.py` to see what your key can serve.
AUDITOR_VISION_MODEL=gemini-3.1-flash-lite
